# Copy to tools/local.env (git-ignored) and adjust. Sourced by tools/env.sh.

# Your TV's adb address (enable ADB debugging in the TV's developer options).
export NIMBUS_DEVICE="192.168.1.50:5555"

# Release signing: a properties file with storeFile, storePassword, keyAlias and keyPassword.
# Without it, release builds are unsigned and tools/deploy.sh can't install them.
# export NIMBUS_SIGNING_PROPERTIES="$HOME/.config/nimbus/signing.properties"

# Only if JDK 21 / the Android SDK / adb aren't already set up:
# export JAVA_HOME="$HOME/jdk-21"
# export ANDROID_HOME="$HOME/Android/Sdk"
# export PATH="$JAVA_HOME/bin:$ANDROID_HOME/platform-tools:$PATH"

# Household hub data (tools/publish.sh, tools/hub): defaults to ~/.local/share/nimbus-hub.
# export NIMBUS_HUB_DATA="$HOME/.local/share/nimbus-hub"
